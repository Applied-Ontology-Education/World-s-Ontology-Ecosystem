```ttl
@prefix :      <http://example.org/ontology/vmpr#> .
@prefix vmpr:  <http://example.org/ontology/vmpr#> .
@prefix obo:   <http://purl.obolibrary.org/obo/> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base          <http://example.org/ontology/vmpr> .

#################################################################
# Ontology header
#################################################################

<http://example.org/ontology/vmpr>
    a owl:Ontology ;
    owl:versionIRI <http://example.org/ontology/vmpr/0.2.0> ;
    dcterms:title "Vehicle Maintenance Problem Reporting Ontology (VMPR)"@en ;
    dcterms:creator "Sean Tucker" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    rdfs:comment "Revised ontology created for ontology-evaluation exercise."@en .

#################################################################
# Annotation properties
#################################################################

obo:IAO_0000115 a owl:AnnotationProperty ;
    rdfs:label "definition"@en .

obo:IAO_0000112 a owl:AnnotationProperty ;
    rdfs:label "example of usage"@en .

dcterms:title   a owl:AnnotationProperty .
dcterms:creator a owl:AnnotationProperty .
dcterms:license a owl:AnnotationProperty .

#################################################################
# Upper-level classes
#################################################################

obo:BFO_0000001 a owl:Class ;
    rdfs:label "entity"@en .

obo:BFO_0000002 a owl:Class ;
    rdfs:label "continuant"@en ;
    rdfs:subClassOf obo:BFO_0000001 ;
    owl:disjointWith obo:BFO_0000003 .

obo:BFO_0000003 a owl:Class ;
    rdfs:label "occurrent"@en ;
    rdfs:subClassOf obo:BFO_0000001 .

obo:BFO_0000004 a owl:Class ;
    rdfs:label "independent continuant"@en ;
    rdfs:subClassOf obo:BFO_0000002 .

obo:BFO_0000040 a owl:Class ;
    rdfs:label "material entity"@en ;
    rdfs:subClassOf obo:BFO_0000004 .

obo:BFO_0000030 a owl:Class ;
    rdfs:label "object"@en ;
    rdfs:subClassOf obo:BFO_0000040 .

obo:BFO_0000020 a owl:Class ;
    rdfs:label "specifically dependent continuant"@en ;
    rdfs:subClassOf obo:BFO_0000002 .

obo:BFO_0000019 a owl:Class ;
    rdfs:label "quality"@en ;
    rdfs:subClassOf obo:BFO_0000020 .

obo:BFO_0000017 a owl:Class ;
    rdfs:label "realizable entity"@en ;
    rdfs:subClassOf obo:BFO_0000020 ;
    owl:disjointWith obo:BFO_0000019 .

obo:BFO_0000016 a owl:Class ;
    rdfs:label "disposition"@en ;
    rdfs:subClassOf obo:BFO_0000017 .

obo:BFO_0000023 a owl:Class ;
    rdfs:label "role"@en ;
    rdfs:subClassOf obo:BFO_0000017 ;
    owl:disjointWith obo:BFO_0000016 .

obo:BFO_0000031 a owl:Class ;
    rdfs:label "generically dependent continuant"@en ;
    rdfs:subClassOf obo:BFO_0000002 .

obo:BFO_0000015 a owl:Class ;
    rdfs:label "process"@en ;
    rdfs:subClassOf obo:BFO_0000003 .

obo:IAO_0000030 a owl:Class ;
    rdfs:label "information content entity"@en ;
    rdfs:subClassOf obo:BFO_0000031 ;
    obo:IAO_0000115
        "A generically dependent continuant that is about some entity."@en .

[] a owl:AllDisjointClasses ;
   owl:members (
       obo:BFO_0000004
       obo:BFO_0000020
       obo:BFO_0000031
   ) .

#################################################################
# Upper-level object properties
#################################################################

obo:BFO_0000050 a owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:label "part of"@en ;
    owl:inverseOf obo:BFO_0000051 .

obo:BFO_0000051 a owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:label "has part"@en .

obo:RO_0000052 a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "inheres in"@en ;
    owl:inverseOf obo:RO_0000053 ;
    rdfs:domain obo:BFO_0000020 ;
    rdfs:range obo:BFO_0000004 .

obo:RO_0000053 a owl:ObjectProperty ;
    rdfs:label "bearer of"@en ;
    rdfs:domain obo:BFO_0000004 ;
    rdfs:range obo:BFO_0000020 .

obo:RO_0000057 a owl:ObjectProperty ;
    rdfs:label "has participant"@en ;
    owl:inverseOf obo:RO_0000056 ;
    rdfs:domain obo:BFO_0000003 ;
    rdfs:range obo:BFO_0000002 .

obo:RO_0000056 a owl:ObjectProperty ;
    rdfs:label "participates in"@en .

obo:RO_0002233 a owl:ObjectProperty ;
    rdfs:label "has input"@en ;
    rdfs:subPropertyOf obo:RO_0000057 ;
    owl:inverseOf obo:RO_0002352 .

obo:RO_0002352 a owl:ObjectProperty ;
    rdfs:label "input of"@en .

obo:RO_0002234 a owl:ObjectProperty ;
    rdfs:label "has output"@en ;
    rdfs:subPropertyOf obo:RO_0000057 ;
    owl:inverseOf obo:RO_0002353 .

obo:RO_0002353 a owl:ObjectProperty ;
    rdfs:label "output of"@en .

obo:BFO_0000055 a owl:ObjectProperty ;
    rdfs:label "realizes"@en ;
    rdfs:domain obo:BFO_0000015 ;
    rdfs:range obo:BFO_0000017 .

obo:IAO_0000136 a owl:ObjectProperty ;
    rdfs:label "is about"@en ;
    rdfs:domain obo:IAO_0000030 .

#################################################################
# Domain object properties
#################################################################

:reportsProblem a owl:ObjectProperty ;
    rdfs:label "reports problem"@en ;
    rdfs:subPropertyOf obo:IAO_0000136 ;
    rdfs:domain :ProblemReport ;
    rdfs:range :VehicleProblem ;
    obo:IAO_0000115
        "A relation between a maintenance problem report and the vehicle problem asserted in that report."@en .

:hasAssignedProblemCode a owl:ObjectProperty ;
    rdfs:label "has assigned problem code"@en ;
    rdfs:domain :ProblemReport ;
    rdfs:range :ProblemCode ;
    obo:IAO_0000115
        "A relation between a maintenance problem report and the problem code assigned to it."@en .

:isInResponseTo a owl:ObjectProperty ;
    rdfs:label "is in response to"@en ;
    rdfs:domain :MaintenanceActivity ;
    rdfs:range :ProblemReport ;
    obo:IAO_0000115
        "A relation between a maintenance activity and the problem report that prompted the activity."@en .

:derivesFromObservation a owl:ObjectProperty ;
    rdfs:label "derives from observation"@en ;
    rdfs:domain :ProblemReport ;
    rdfs:range :Observation ;
    owl:propertyChainAxiom (
        obo:RO_0002353
        obo:RO_0002233
        obo:RO_0002353
    ) .

:problemAffectsVehicle a owl:ObjectProperty ;
    rdfs:label "problem affects vehicle"@en ;
    rdfs:domain :VehicleProblem ;
    rdfs:range :Vehicle ;
    owl:propertyChainAxiom (
        obo:RO_0000052
        obo:BFO_0000050
    ) ;
    obo:IAO_0000115
        "A relation between a vehicle problem and a vehicle when the problem inheres in a component that is part of that vehicle."@en .

:hasTechnicianParticipant a owl:ObjectProperty ;
    rdfs:label "has technician participant"@en ;
    rdfs:subPropertyOf obo:RO_0000057 ;
    rdfs:domain :MaintenanceActivity ;
    rdfs:range :Technician .

:arisesFromDefect a owl:ObjectProperty ;
    rdfs:label "arises from defect"@en ;
    rdfs:domain :VehicleFailureDisposition ;
    rdfs:range :VehicleProblem ;
    obo:IAO_0000115
        "A relation between a vehicle failure disposition and a vehicle problem when the physical defect contributes to the existence of that disposition."@en .

:hasMeasurementUnit a owl:ObjectProperty ;
    rdfs:label "has measurement unit"@en ;
    rdfs:domain :OdometerReading ;
    rdfs:range :MeasurementUnit ;
    obo:IAO_0000115
        "A relation between a measurement information entity and the measurement unit used to express its value."@en .

#################################################################
# Data properties
#################################################################

:hasTextValue a owl:DatatypeProperty ;
    rdfs:label "has text value"@en ;
    rdfs:domain obo:IAO_0000030 ;
    rdfs:range xsd:string ;
    obo:IAO_0000115
        "A data relation between an information content entity and a string used to encode textual content associated with that information content entity."@en .

:hasCodeValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "has code value"@en ;
    rdfs:subPropertyOf :hasTextValue ;
    rdfs:domain :ProblemCode ;
    rdfs:range xsd:string .

:hasReportIdentifier a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "has report identifier"@en ;
    rdfs:domain :ProblemReport ;
    rdfs:range xsd:string .

:hasNumericValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "has numeric value"@en ;
    rdfs:domain :OdometerReading ;
    rdfs:range xsd:decimal .

:hasVINValue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "has VIN value"@en ;
    rdfs:domain :Vehicle ;
    rdfs:range xsd:string .

:hasPersonName a owl:DatatypeProperty ;
    rdfs:label "has person name"@en ;
    rdfs:domain :Person ;
    rdfs:range xsd:string .

:hasStartTime a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "has start time"@en ;
    rdfs:domain obo:BFO_0000015 ;
    rdfs:range xsd:dateTime .

:hasEndTime a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "has end time"@en ;
    rdfs:domain obo:BFO_0000015 ;
    rdfs:range xsd:dateTime .

#################################################################
# Domain classes — independent continuants
#################################################################

:Vehicle a owl:Class ;
    rdfs:label "vehicle"@en ;
    rdfs:subClassOf obo:BFO_0000030 ;
    obo:IAO_0000115
        "An object engineered to transport persons or cargo."@en .

:VehicleComponent a owl:Class ;
    rdfs:label "vehicle component"@en ;
    rdfs:subClassOf
        obo:BFO_0000030 ,
        [
            a owl:Restriction ;
            owl:onProperty obo:BFO_0000050 ;
            owl:someValuesFrom :Vehicle
        ] ;
    obo:IAO_0000115
        "An object that is a component of some vehicle."@en .

:BrakePad a owl:Class ;
    rdfs:label "brake pad"@en ;
    rdfs:subClassOf :VehicleComponent ;
    obo:IAO_0000115
        "A vehicle component that provides friction during braking."@en .

:Person a owl:Class ;
    rdfs:label "person"@en ;
    rdfs:subClassOf obo:BFO_0000030 ;
    obo:IAO_0000115
        "An object that is a human being."@en .

#################################################################
# Domain classes — dependent continuants
#################################################################

:VehicleProblem a owl:Class ;
    rdfs:label "vehicle problem"@en ;
    rdfs:subClassOf
        obo:BFO_0000019 ,
        [
            a owl:Restriction ;
            owl:onProperty obo:RO_0000052 ;
            owl:someValuesFrom [
                a owl:Class ;
                owl:unionOf ( :Vehicle :VehicleComponent )
            ]
        ] ;
    obo:IAO_0000115
        "A quality of a vehicle or vehicle component that constitutes a departure from an intended physical condition or specification."@en .

:VehicleFailureDisposition a owl:Class ;
    rdfs:label "vehicle failure disposition"@en ;
    rdfs:subClassOf
        obo:BFO_0000016 ,
        [
            a owl:Restriction ;
            owl:onProperty obo:RO_0000052 ;
            owl:someValuesFrom [
                a owl:Class ;
                owl:unionOf ( :Vehicle :VehicleComponent )
            ]
        ] ;
    obo:IAO_0000115
        "A disposition of a vehicle or vehicle component toward degraded or failed performance."@en .

:ObservableVehicleCondition a owl:Class ;
    rdfs:label "observable vehicle condition"@en ;
    rdfs:subClassOf
        obo:BFO_0000019 ,
        [
            a owl:Restriction ;
            owl:onProperty obo:RO_0000052 ;
            owl:someValuesFrom [
                a owl:Class ;
                owl:unionOf ( :Vehicle :VehicleComponent )
            ]
        ] ;
    obo:IAO_0000115
        "A quality of a vehicle or vehicle component that can be detected by observation or measurement."@en .

:CumulativeTravelDistance a owl:Class ;
    rdfs:label "cumulative travel distance"@en ;
    rdfs:subClassOf
        obo:BFO_0000019 ,
        [
            a owl:Restriction ;
            owl:onProperty obo:RO_0000052 ;
            owl:someValuesFrom :Vehicle
        ] ;
    obo:IAO_0000115
        "A quality associated with a vehicle that represents the cumulative distance attributed to its travel."@en .

:TechnicianRole a owl:Class ;
    rdfs:label "technician role"@en ;
    rdfs:subClassOf
        obo:BFO_0000023 ,
        [
            a owl:Restriction ;
            owl:onProperty obo:RO_0000052 ;
            owl:someValuesFrom :Person
        ] ;
    obo:IAO_0000115
        "A role borne by a person and realized in vehicle maintenance activities."@en .

:VehicleOperatorRole a owl:Class ;
    rdfs:label "vehicle operator role"@en ;
    rdfs:subClassOf
        obo:BFO_0000023 ,
        [
            a owl:Restriction ;
            owl:onProperty obo:RO_0000052 ;
            owl:someValuesFrom :Person
        ] .

#################################################################
# Defined class — Technician
#################################################################

:Technician a owl:Class ;
    rdfs:label "technician"@en ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            :Person
            [
                a owl:Restriction ;
                owl:onProperty obo:RO_0000053 ;
                owl:someValuesFrom :TechnicianRole
            ]
        )
    ] ;
    obo:IAO_0000115
        "A person who bears a technician role."@en .

#################################################################
# Domain classes — processes
#################################################################

:ProblemManifestation a owl:Class ;
    rdfs:label "problem manifestation"@en ;
    rdfs:subClassOf
        obo:BFO_0000015 ,
        [
            a owl:Restriction ;
            owl:onProperty obo:BFO_0000055 ;
            owl:someValuesFrom :VehicleFailureDisposition
        ] ;
    obo:IAO_0000115
        "A process that realizes a vehicle failure disposition."@en .

:Observation a owl:Class ;
    rdfs:label "observation"@en ;
    rdfs:subClassOf
        obo:BFO_0000015 ,
        [
            a owl:Restriction ;
            owl:onProperty obo:RO_0000057 ;
            owl:someValuesFrom :Vehicle
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty obo:RO_0000057 ;
            owl:someValuesFrom :Person
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty obo:RO_0002234 ;
            owl:someValuesFrom :ObservationRecord
        ] ;
    obo:IAO_0000115
        "A process in which a person observes a vehicle or vehicle component and produces an observation record."@en .

:ProblemReportingProcess a owl:Class ;
    rdfs:label "problem reporting process"@en ;
    rdfs:subClassOf
        obo:BFO_0000015 ,
        [
            a owl:Restriction ;
            owl:onProperty obo:RO_0002233 ;
            owl:someValuesFrom :ObservationRecord
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty obo:RO_0002234 ;
            owl:someValuesFrom :ProblemReport
        ] .

:MaintenanceActivity a owl:Class ;
    rdfs:label "maintenance activity"@en ;
    rdfs:subClassOf
        obo:BFO_0000015 ,
        [
            a owl:Restriction ;
            owl:onProperty obo:RO_0000057 ;
            owl:someValuesFrom :Vehicle
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty :hasTechnicianParticipant ;
            owl:someValuesFrom :Technician
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty obo:BFO_0000055 ;
            owl:someValuesFrom :TechnicianRole
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty :isInResponseTo ;
            owl:someValuesFrom :ProblemReport
        ] .

:BrakePadReplacement a owl:Class ;
    rdfs:label "brake pad replacement"@en ;
    rdfs:subClassOf :MaintenanceActivity .

#################################################################
# Domain classes — information content entities
#################################################################

:ObservationRecord a owl:Class ;
    rdfs:label "observation record"@en ;
    rdfs:subClassOf
        obo:IAO_0000030 ,
        [
            a owl:Restriction ;
            owl:onProperty obo:RO_0002353 ;
            owl:someValuesFrom :Observation
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty obo:IAO_0000136 ;
            owl:someValuesFrom :ObservableVehicleCondition
        ] .

:ProblemReport a owl:Class ;
    rdfs:label "maintenance problem report"@en ;
    rdfs:subClassOf
        obo:IAO_0000030 ,
        [
            a owl:Restriction ;
            owl:onProperty obo:RO_0002353 ;
            owl:someValuesFrom :ProblemReportingProcess
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty :reportsProblem ;
            owl:someValuesFrom :VehicleProblem
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty :hasAssignedProblemCode ;
            owl:someValuesFrom :ProblemCode
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty obo:BFO_0000051 ;
            owl:someValuesFrom :ObservedConditionDescription
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty :derivesFromObservation ;
            owl:someValuesFrom :Observation
        ] .

:ObservedConditionDescription a owl:Class ;
    rdfs:label "observed condition description"@en ;
    rdfs:subClassOf
        obo:IAO_0000030 ,
        [
            a owl:Restriction ;
            owl:onProperty obo:BFO_0000050 ;
            owl:someValuesFrom :ProblemReport
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty obo:IAO_0000136 ;
            owl:someValuesFrom :ObservableVehicleCondition
        ] .

:OdometerReading a owl:Class ;
    rdfs:label "odometer reading"@en ;
    rdfs:subClassOf
        obo:IAO_0000030 ,
        [
            a owl:Restriction ;
            owl:onProperty obo:IAO_0000136 ;
            owl:someValuesFrom :CumulativeTravelDistance
        ] ;
    obo:IAO_0000115
        "An information content entity that records a value for a vehicle's cumulative travel distance."@en .

:ProblemCode a owl:Class ;
    rdfs:label "problem code"@en ;
    rdfs:subClassOf obo:IAO_0000030 ;
    obo:IAO_0000115
        "An information content entity drawn from a controlled maintenance coding scheme."@en .

:MeasurementUnit a owl:Class ;
    rdfs:label "measurement unit"@en ;
    rdfs:subClassOf obo:BFO_0000031 ;
    obo:IAO_0000115
        "A generically dependent continuant that specifies a standard unit used to express a measurement value."@en .

#################################################################
# Named individuals — material entities
#################################################################

:vehicle_T0417
    a owl:NamedIndividual , :Vehicle ;
    rdfs:label "service truck T-0417"@en ;
    :hasVINValue "1FTBW3XM5KKA00417" .

:brakePad_T0417_FL
    a owl:NamedIndividual , :BrakePad ;
    rdfs:label "front-left brake pad of truck T-0417"@en ;
    obo:BFO_0000050 :vehicle_T0417 .

:person_driver_01
    a owl:NamedIndividual , :Person ;
    rdfs:label "driver 01"@en ;
    :hasPersonName "Dana Morales" ;
    obo:RO_0000053 :role_operator_01 .

:person_tech_01
    a owl:NamedIndividual , :Person , :Technician ;
    rdfs:label "technician 01"@en ;
    :hasPersonName "Luis Chen" ;
    obo:RO_0000053 :role_technician_01 .

#################################################################
# Roles, qualities, defects, dispositions
#################################################################

:role_operator_01
    a owl:NamedIndividual , :VehicleOperatorRole ;
    rdfs:label "vehicle operator role of driver 01"@en ;
    obo:RO_0000052 :person_driver_01 .

:role_technician_01
    a owl:NamedIndividual , :TechnicianRole ;
    rdfs:label "technician role of technician 01"@en ;
    obo:RO_0000052 :person_tech_01 .

:problem_brakeWear_01
    a owl:NamedIndividual , :VehicleProblem ;
    rdfs:label "worn front-left brake pad condition"@en ;
    obo:RO_0000052 :brakePad_T0417_FL ;
    :problemAffectsVehicle :vehicle_T0417 .

:failureDisposition_brakeWear_01
    a owl:NamedIndividual , :VehicleFailureDisposition ;
    rdfs:label "disposition toward degraded braking caused by front-left brake wear"@en ;
    obo:RO_0000052 :brakePad_T0417_FL ;
    :arisesFromDefect :problem_brakeWear_01 .

:condition_padThin_01
    a owl:NamedIndividual , :ObservableVehicleCondition ;
    rdfs:label "worn-thin condition of front-left brake pad"@en ;
    obo:RO_0000052 :brakePad_T0417_FL .

:cumulativeTravelDistance_T0417_01
    a owl:NamedIndividual , :CumulativeTravelDistance ;
    rdfs:label "cumulative travel distance of truck T-0417 at report time"@en ;
    obo:RO_0000052 :vehicle_T0417 .

#################################################################
# Measurement units
#################################################################

:mile
    a owl:NamedIndividual , :MeasurementUnit ;
    rdfs:label "mile"@en .

#################################################################
# Processes
#################################################################

:manifestation_grinding_01
    a owl:NamedIndividual , :ProblemManifestation ;
    rdfs:label "grinding noise during braking, truck T-0417"@en ;
    obo:BFO_0000055 :failureDisposition_brakeWear_01 ;
    obo:RO_0000057 :vehicle_T0417 , :brakePad_T0417_FL ;
    :hasStartTime "2026-03-09T16:40:00-05:00"^^xsd:dateTime .

:observation_01
    a owl:NamedIndividual , :Observation ;
    rdfs:label "driver observation of brake grinding and pad wear"@en ;
    obo:RO_0000057 :vehicle_T0417 , :brakePad_T0417_FL , :person_driver_01 ;
    obo:RO_0002234 :observationRecord_01 ;
    :hasStartTime "2026-03-09T17:05:00-05:00"^^xsd:dateTime ;
    :hasEndTime "2026-03-09T17:15:00-05:00"^^xsd:dateTime .

:reporting_01
    a owl:NamedIndividual , :ProblemReportingProcess ;
    rdfs:label "filing of problem report MPR-2026-00873"@en ;
    obo:RO_0000057 :person_driver_01 ;
    obo:RO_0002233 :observationRecord_01 ;
    obo:RO_0002234 :report_MPR_2026_00873 ;
    :hasStartTime "2026-03-09T17:20:00-05:00"^^xsd:dateTime ;
    :hasEndTime "2026-03-09T17:32:00-05:00"^^xsd:dateTime .

:maintenance_01
    a owl:NamedIndividual , :BrakePadReplacement ;
    rdfs:label "front brake pad replacement on truck T-0417"@en ;
    :isInResponseTo :report_MPR_2026_00873 ;
    obo:RO_0000057 :vehicle_T0417 , :brakePad_T0417_FL ;
    :hasTechnicianParticipant :person_tech_01 ;
    obo:BFO_0000055 :role_technician_01 ;
    :hasStartTime "2026-03-10T08:15:00-05:00"^^xsd:dateTime ;
    :hasEndTime "2026-03-10T09:40:00-05:00"^^xsd:dateTime .

#################################################################
# Information content entities
#################################################################

:observationRecord_01
    a owl:NamedIndividual , :ObservationRecord ;
    rdfs:label "observation record 01"@en ;
    obo:IAO_0000136 :condition_padThin_01 ;
    :hasTextValue
        "Grinding noise when braking; front-left pad visibly thin." .

:report_MPR_2026_00873
    a owl:NamedIndividual , :ProblemReport ;
    rdfs:label "maintenance problem report MPR-2026-00873"@en ;
    :hasReportIdentifier "MPR-2026-00873" ;
    :reportsProblem :problem_brakeWear_01 ;
    :hasAssignedProblemCode :problemCode_BRK_042 ;
    :derivesFromObservation :observation_01 ;
    obo:BFO_0000051 :conditionDescription_01 , :odometerReading_01 .

:conditionDescription_01
    a owl:NamedIndividual , :ObservedConditionDescription ;
    rdfs:label "observed condition description in MPR-2026-00873"@en ;
    obo:BFO_0000050 :report_MPR_2026_00873 ;
    obo:IAO_0000136 :condition_padThin_01 ;
    :hasTextValue
        "Front-left brake pad worn below 3 mm; metal-on-metal grinding audible under braking." .

:odometerReading_01
    a owl:NamedIndividual , :OdometerReading ;
    rdfs:label "odometer reading in MPR-2026-00873"@en ;
    obo:BFO_0000050 :report_MPR_2026_00873 ;
    obo:IAO_0000136 :cumulativeTravelDistance_T0417_01 ;
    :hasNumericValue "48210"^^xsd:decimal ;
    :hasMeasurementUnit :mile .

:problemCode_BRK_042
    a owl:NamedIndividual , :ProblemCode ;
